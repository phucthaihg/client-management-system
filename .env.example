# App Configuration
NODE_ENV=development
PORT=4000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# Database & Cache
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pbx_crm_db?schema=public"
REDIS_URL="redis://localhost:6379"

# Security & JWT
JWT_SECRET="super-secret-jwt-key"
JWT_EXPIRES_IN="1d"

# Twilio Master Account (Dùng để provision subaccounts & cấp token)
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_auth_token"
TWILIO_API_KEY_SID="SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_API_KEY_SECRET="your_api_key_secret"
TWILIO_APP_SID="APxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Stripe Billing
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxx"

# AI Services
OPENAI_API_KEY="sk-proj-xxxxxxxxxxxxxxxxxxxxxxx"
DEEPGRAM_API_KEY="your_deepgram_key"

# Encrypted Audio Storage (S3 / Cloudflare R2)
S3_BUCKET_NAME="pbx-call-recordings"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="your_aws_access_key"
S3_SECRET_ACCESS_KEY="your_aws_secret_key"
