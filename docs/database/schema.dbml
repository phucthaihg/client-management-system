// ==========================================
// PBX CRM SAAS - DATABASE SCHEMA (DBML)
// ==========================================

Table tenants {
  id uuid [pk, default: `uuid_generate_v4()`]
  name varchar(255) [not null]
  slug varchar(100) [unique, not null]
  subscription_status varchar(50) [default: 'active']
  stripe_customer_id varchar(255)
  created_at timestamp [default: `current_timestamp`]
}

Table users {
  id uuid [pk, default: `uuid_generate_v4()`]
  tenant_id uuid [not null]
  email varchar(255) [not null]
  password_hash varchar(255) [not null]
  full_name varchar(150) [not null]
  role varchar(50) [default: 'AGENT', note: 'SUPER_ADMIN, ADMIN, AGENT']
  created_at timestamp [default: `current_timestamp`]
  
  indexes {
    (tenant_id, email) [unique]
  }
}

Table customers {
  id uuid [pk, default: `uuid_generate_v4()`]
  tenant_id uuid [not null]
  full_name varchar(150) [not null]
  phone_number varchar(50) [not null]
  email varchar(255)
  custom_fields jsonb [default: `{}`]
  created_at timestamp [default: `current_timestamp`]

  indexes {
    (tenant_id, phone_number)
  }
}

Table phone_numbers {
  id uuid [pk, default: `uuid_generate_v4()`]
  tenant_id uuid [not null]
  phone_number varchar(50) [unique, not null]
  twilio_sid varchar(100) [not null]
  assigned_user_id uuid
}

Table call_logs {
  id uuid [pk, default: `uuid_generate_v4()`]
  tenant_id uuid [not null]
  customer_id uuid
  user_id uuid
  call_sid varchar(100) [unique, not null]
  direction varchar(20) [note: 'inbound, outbound']
  duration_seconds int [default: 0]
  recording_url text
  status varchar(50) [default: 'completed']
  started_at timestamp [default: `current_timestamp`]

  indexes {
    (tenant_id, started_at)
  }
}

Table call_summaries {
  id uuid [pk, default: `uuid_generate_v4()`]
  tenant_id uuid [not null]
  call_log_id uuid [unique, not null]
  transcript text
  summary text
  sentiment varchar(30)
  action_items jsonb [default: `[]`]
  created_at timestamp [default: `current_timestamp`]
}

Table appointments {
  id uuid [pk, default: `uuid_generate_v4()`]
  tenant_id uuid [not null]
  customer_id uuid [not null]
  assigned_user_id uuid
  start_time timestamp [not null]
  end_time timestamp [not null]
  status varchar(50) [default: 'scheduled', note: 'scheduled, completed, cancelled']
  notes text
  created_at timestamp [default: `current_timestamp`]

  indexes {
    (tenant_id, start_time)
  }
}

// ==========================================
// FOREIGN KEY RELATIONSHIPS
// ==========================================

Ref: tenants.id < users.tenant_id [delete: cascade]
Ref: tenants.id < customers.tenant_id [delete: cascade]
Ref: tenants.id < phone_numbers.tenant_id [delete: cascade]
Ref: tenants.id < call_logs.tenant_id [delete: cascade]
Ref: tenants.id < call_summaries.tenant_id [delete: cascade]
Ref: tenants.id < appointments.tenant_id [delete: cascade]

Ref: users.id < phone_numbers.assigned_user_id [delete: set null]
Ref: users.id < call_logs.user_id [delete: set null]
Ref: users.id < appointments.assigned_user_id [delete: set null]

Ref: customers.id < call_logs.customer_id [delete: set null]
Ref: customers.id < appointments.customer_id [delete: cascade]

Ref: call_logs.id - call_summaries.call_log_id [delete: cascade]